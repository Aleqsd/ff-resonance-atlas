// Cloudflare Worker (static assets only) serving the project page at https://ff-resonance-atlas.zqsdev.com.
// Workers Builds runs `bash tools/build-site.sh` (Jekyll, docs/ -> _site/) then `npx wrangler deploy` on every push to main.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ff-resonance-atlas",
  "compatibility_date": "2026-10-01",
  "account_id": "7b9ee223c6a171ffa7672f2c34bf7c16",
  "assets": {
    "directory": "./_site",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [{ "pattern": "ff-resonance-atlas.zqsdev.com", "custom_domain": true }],
  "workers_dev": true,
  "preview_urls": false
}
